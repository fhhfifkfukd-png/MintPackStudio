# Generate a random value at least 32 characters long.
MINTPACK_API_KEY=CHANGE_ME
MINTPACK_DATA_DIR=./mintpack-data
GRADLE_BIN=gradle
ANDROID_SDK_ROOT=/path/to/Android/Sdk
ANDROID_HOME=/path/to/Android/Sdk
BUILD_WORKERS=1
BUILD_TIMEOUT_SECONDS=1800
MAX_PENDING_JOBS=3
MINTPACK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://appassets.androidplatform.net
